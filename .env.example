# Production settings. Copy to .env and replace every value. .env is git-ignored.

# The address the CLI and installed apps use to reach the API. Must be HTTPS.
PUBLIC_URL=https://ota.example.com

# The image tag to run: latest follows main, dev follows the dev branch.
OTA_SERVER_IMAGE=ghcr.io/osama-alharbi9/ota-server:latest
OTA_CONSOLE_IMAGE=ghcr.io/osama-alharbi9/ota-console:latest

# Generate each with: openssl rand -hex 32
DB_PASSWORD=change_me
S3_SECRET_KEY=change_me
JWT_SECRET=change_me
S3_ACCESS_KEY=ota

# First admin account, created on first start if it does not exist.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change_me

# Optional API key for scripts. Generate: echo "ota_$(openssl rand -hex 24)"
API_TOKEN=

# The console origin allowed to call the API with cookies.
WEB_ORIGIN=https://console.ota.example.com
