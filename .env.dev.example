# Local development settings. Copy to .env.dev. Safe defaults for your own machine only.

# Android emulators reach this through `adb reverse tcp:8080 tcp:8080`. For a
# physical phone, use your computer's LAN address instead.
PUBLIC_URL=http://localhost:8080

DB_PASSWORD=dev_password
S3_ACCESS_KEY=ota
S3_SECRET_KEY=dev_secret_key
JWT_SECRET=dev_jwt_secret_not_for_production

BOOTSTRAP_EMAIL=dev@example.com
BOOTSTRAP_PASSWORD=dev_password
API_TOKEN=ota_dev_token_not_for_production

WEB_ORIGIN=http://localhost:3100
